{
  "name": "@gpt-canvas/canvas-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit --pretty false",
    "test:built": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test": "npm run build && npm run test:built",
    "clean": "node -e \"const fs=require('fs'); for(const p of ['dist','.test-dist']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gpt-canvas/shared": "0.1.0",
    "konva": "10.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.5"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}

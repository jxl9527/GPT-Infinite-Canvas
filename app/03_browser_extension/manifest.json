{
  "manifest_version": 3,
  "name": "GPT Canvas Bridge",
  "version": "1.5.20",
  "description": "GPT Canvas：从本地画布一键桥接 ChatGPT 或 Google Flow，自动执行单图生成与回图。",
  "permissions": ["storage", "tabs", "debugger"],
  "host_permissions": [
    "http://127.0.0.1:3220/*",
    "http://127.0.0.1:3230/*",
    "http://localhost:3230/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://labs.google/*"
  ],
  "action": {
    "default_title": "GPT Canvas Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://labs.google/fx/*"],
      "js": [
        "content/page-state.js",
        "content/chatgpt-adapter.js",
        "content/flow-adapter.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:3230/*", "http://localhost:3230/*"],
      "js": ["content/canvas-trigger.js"],
      "run_at": "document_idle"
    }
  ]
}
